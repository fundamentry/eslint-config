{
  "$schema": "https://json.schemastore.org/package",
  "name": "@fundamentry/eslint-config",
  "description": "Shareable and extensible ESLint configurations.",
  "repository": {
    "type": "git",
    "url": "git@github.com:fundamentry/eslint-config.git"
  },
  "contributors": [
    {
      "name": "Alexander Zakharov (azaxarov)",
      "email": "alexander.zakharov@fundamentry.org"
    }
  ],
  "private": true,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0"
    }
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8",
  "scripts": {
    "build": "lerna run build",
    "commit": "cz",
    "lint": "run-p lint:eslint",
    "lint:eslint": "eslint --ext ts,js,json .",
    "lint:eslint:fix": "eslint --ext ts,js,json . --fix",
    "lint:eslint:staged:fix": "eslint --ext ts,js,json --fix",
    "lint:fix": "run-p lint:eslint:fix",
    "lint:staged:fix": "run-p lint:eslint:staged:fix -- {@}",
    "prepare": "husky",
    "update": "lernaupdate"
  },
  "dependencies": {
    "eslint": "8.57.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.0",
    "@commitlint/config-conventional": "21.2.0",
    "@fundamentry/eslint-config-json": "workspace:*",
    "@fundamentry/eslint-config-prettier": "workspace:*",
    "@fundamentry/eslint-config-typescript": "workspace:*",
    "@fundamentry/typescript-config": "2.0.0",
    "@types/eslint": "8.56.12",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-deprecation": "3.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-json-format": "2.0.1",
    "eslint-plugin-prettier": "5.5.6",
    "husky": "9.1.7",
    "lerna": "9.0.7",
    "lerna-update-wizard": "1.1.2",
    "lint-staged": "17.0.8",
    "npm-run-all": "4.1.5",
    "prettier": "3.9.4",
    "rimraf": "6.1.3",
    "typescript": "6.0.3"
  }
}
