{
  "$schema": "https://json.schemastore.org/package",
  "name": "@fundamentry/eslint-config",
  "description": "Shareable and extensible ESLint configurations.",
  "repository": {
    "type": "git",
    "url": "git@github.com:fundamentry/eslint-config.git"
  },
  "contributors": [
    {
      "name": "Alexander Zakharov (azaxarov)",
      "email": "alexander.zakharov@fundamentry.org"
    }
  ],
  "private": true,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0"
    }
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882",
  "scripts": {
    "build": "nx run-many -t build",
    "commit": "cz",
    "lint": "run-p lint:eslint",
    "lint:eslint": "eslint --ext ts,js,json .",
    "lint:eslint:fix": "eslint --ext ts,js,json . --fix",
    "lint:eslint:staged:fix": "eslint --ext ts,js,json --fix",
    "lint:fix": "run-p lint:eslint:fix",
    "lint:staged:fix": "run-p lint:eslint:staged:fix -- {@}",
    "prepare": "husky"
  },
  "dependencies": {
    "eslint": "catalog:"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@fundamentry/eslint-config-json": "workspace:*",
    "@fundamentry/eslint-config-prettier": "workspace:*",
    "@fundamentry/eslint-config-typescript": "workspace:*",
    "@fundamentry/typescript-config": "catalog:",
    "@nx/js": "catalog:",
    "@types/eslint": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "commitizen": "catalog:",
    "cz-conventional-changelog": "catalog:",
    "eslint-config-airbnb": "catalog:",
    "eslint-config-airbnb-base": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-deprecation": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-json-format": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "npm-run-all": "catalog:",
    "nx": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:"
  }
}
