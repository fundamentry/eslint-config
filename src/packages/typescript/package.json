{
  "$schema": "https://json.schemastore.org/package",
  "name": "@fundamentry/eslint-config-typescript",
  "version": "1.1.4",
  "description": "TypeScript ESLint configuration.",
  "repository": {
    "type": "git",
    "url": "git@github.com:fundamentry/eslint-config.git"
  },
  "contributors": [
    {
      "name": "Alexander Zakharov (azaxarov)",
      "email": "alexander.zakharov@fundamentry.org"
    }
  ],
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "files": [
    "lib"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "run-s clean compile",
    "clean": "run-p clean:lib",
    "clean:lib": "rimraf lib",
    "compile": "tsc",
    "prepublishOnly": "run-s build"
  },
  "dependencies": {
    "@fundamentry/eslint-config-base": "workspace:*"
  },
  "peerDependencies": {
    "@typescript-eslint/eslint-plugin": "8.62.1",
    "@typescript-eslint/parser": "8.62.1",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-deprecation": "3.0.0",
    "eslint-plugin-import": "2.32.0",
    "typescript": "6.0.3"
  }
}
